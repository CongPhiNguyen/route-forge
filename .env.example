LITELLM_MASTER_KEY=sk-routeforge-local-master
FAULT_API_KEY=sk-fault-local
# Lane P stays off unless this is exactly 1. This slice still does not send Lane P.
ROUTEFORGE_ALLOW_PAID=
# wsl runs Compose inside ROUTEFORGE_WSL_DISTRO. windows uses docker on PATH.
ROUTEFORGE_DOCKER=windows
ROUTEFORGE_WSL_DISTRO=Ubuntu
